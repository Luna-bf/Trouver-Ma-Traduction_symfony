<header>
	<nav>
		<section class="d-flex justify-content-between input-and-profile">
			<form action="#" class="search-form w-25">
				<div class="d-flex input-wrapper">
					<input type="search" name="search" id="search" class="input-icon" placeholder="Recherche...">
				</div>
			</form>

			{% if profile.profilePictureName is same as(null) %}
				<a href="{{ path('profile_show') }}"  class="user-pfp-header rounded-circle mb-2" style="background-image: url('/assets/imgs/placeholders/default-pfp.png')"></a>
			{% else %}
				<a href="{{ path('profile_show') }}" class="user-pfp-header rounded-circle mb-2" style="background-image: url({{ asset('uploads/profile/profilePictures/' ~ profile.profilePictureName) }})"></a>
			{% endif %}
		</section>
	</nav>
</header>