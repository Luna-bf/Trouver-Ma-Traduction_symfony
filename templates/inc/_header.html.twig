<header>
	<nav class="d-flex align-items-center">
		{# <figure class="nav-logo-figure">
			<a href="#"><img src="/assets/imgs/logo-160x160.png" alt="Website logo" class="nav-logo-img"></a>
		</figure> #}

		<div class="d-flex input-and-profile">
			<form action="#" class="search-form">
				<div class="d-flex input-wrapper">
					<input type="search" name="search" id="search" class="input-icon" placeholder="Recherche...">
				</div>
			</form>

			<figure class="d-flex profile-picture-figure my-0">
				{% if is_granted(("ROLE_USER")) %}
					<a href="{{ path('profile_show') }}"><img src="/assets/imgs/placeholders/default-pfp.png" alt="Profile picture"></a>
				{% endif %}
			</figure>
		</div>
	</nav>
</header>