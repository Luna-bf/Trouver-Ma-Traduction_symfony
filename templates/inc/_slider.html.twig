{% for translation in translations %}
	<article class='rounded-2 swiper-slide'>
		<div class='m-auto card-content' id='{{ translation.id }}'>
			<figure><img src='{{ asset("/assets/imgs/general/slider/#{translation.translationFileExtension}-file-extension.png")}}' alt='File extension' class="rounded-3"/></figure>

			<div class='text-center title'>
				<h3>{{ translation.name }}</h3>
				<h4 class='mt-3 see-translation-link'>
					<a href='{{ asset("uploads/translations/#{translation.translationFilename}") }}'>Voir la traduction</a>
				</h4>
			</div>

			<ul class='text'>
				<li>Type :
					<span>{{ translation.translationType }}</span>
				</li>
				<li>Style :
					<span>{{ translation.translationStyle }}</span>
				</li>
				<li>Auteur :
					<span>{{ translation.author }}</span>
				</li>
				<li>Langue :
					<span>{{ translation.language }}</span>
				</li>
			</ul>

			<ul class='other-infos'>
				<li>Par :
					<span>{{ translation.profile.username }}</span>
				</li>
				<li>Postée le :
					<span>{{ translation.createdAt | date("d/m/Y") }}</span>
				</li>
			</ul>
		</div>
	</article>
{% endfor %}
