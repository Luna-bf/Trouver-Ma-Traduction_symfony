{% for translation in translations %}
	<article class='rounded-2 swiper-slide'>
		<div class='m-auto card-content' id='{{ translation.id }}'>
			<figure><img src='{{ asset("/assets/imgs/general/slider/#{translation.translationFileExtension}-file-extension.png")}}' alt='File extension' class="rounded-3 card-content__img"/></figure>

			<div class='text-center'>
				<h3>{{ translation.name }}</h3>
				<h4 class='mt-3 see-translation-link'>
					<a href='{{ asset("uploads/translations/#{translation.translationFilename}") }}'>{% trans %}Voir la traduction{% endtrans %}</a>
				</h4>
			</div>

			<ul class='text'>
				<li>{% trans %}Type :{% endtrans %}
					<span>{{ translation.translationType.value }}</span>
				</li>
				<li>{% trans %}Style :{% endtrans %}
					<span>{{ translation.translationStyle.value }}</span>
				</li>
				<li>{% trans %}Auteur :{% endtrans %}
					<span>{{ translation.author }}</span>
				</li>
				<li>{% trans %}Langue :{% endtrans %}
					<span>{{ translation.language }}</span>
				</li>
			</ul>

			<ul class='other-infos'>
				<li>{% trans %}Par :{% endtrans %}
					<span>{{ translation.profile.username }}</span>
				</li>
				<li>{% trans %}Postée le :{% endtrans %}
					<span>{{ translation.createdAt | date("d/m/Y") }}</span>
				</li>
			</ul>
		</div>
	</article>
{% endfor %}
