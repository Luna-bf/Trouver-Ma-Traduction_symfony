{% extends "base.html.twig" %}

{% block title %}Paramètres du profil - Trouver Ma Traduction
{% endblock %}

{% block main %}
	<main>
		<section class="settings-container d-flex flex-row justify-content-center mx-auto">
			<article class="settings-parent">
				{# Settings pages links #}
				<ul class="all-settings d-flex flex-column">
					<li class="mt-0 border-left">
						<a href="{{ path('profile_settings') }}" class="d-flex">
							<i class="fa-solid fa-user"></i>{% trans %}Profil{% endtrans %}</a>
					</li>
					<li>
						<a href="{{ path('profile_preferences_settings') }}" class="d-flex">
							<i class="fa-solid fa-bookmark"></i>{% trans %}Préférence de contenu{% endtrans %}</a>
					</li>
					<li>
						<a href="{{ path('profile_accessibility_settings') }}" class="d-flex">
							<i class="fa-solid fa-universal-access"></i>{% trans %}Accessibilité{% endtrans %}</a>
					</li>
					<li>
						<a href="{{ path('user_account_settings') }}" class="d-flex">
							<i class="fa-solid fa-gear"></i>{% trans %}Votre compte{% endtrans %}</a>
					</li>
				</ul>
			</article>

			<article class="edit-parameters">
				<ul class="profile-picture d-flex flex-row align-items-center">
					{% if profile.profilePictureName is empty %}
						<li class="me-4">
							<div class="user-pfp-settings rounded-circle mb-2" style="background-image: url('/assets/imgs/placeholders/default-pfp.png')"></div>
						</li>
					{% else %}
						<li class="me-4">
							<div class="user-pfp-settings rounded-circle mb-2" style="background-image: url('{{ asset('uploads/profile/profilePictures/' ~ profile.profilePictureName) }}')"></div>
						</li>
					{% endif %}
					<li class="ms-2 w-100">{{ profile.username }}</li>
				</ul>

				<div class="d-flex">
					{{ form_start(editProfileForm, {'attr': {'class': 'profile-form w-75'}}) }}
					{{ form_end(editProfileForm) }}
				</div>
			</article>
		</section>
	</main>
{% endblock %}

{% block javascripts %}
	<script src="{{ asset('/js/settings-js/theme.js') }}"></script>
{% endblock %}