{% extends "base.html.twig" %}

{% block title %}{% trans %}Profil{% endtrans %} - Trouver Ma Traduction
{% endblock %}

{% block main %}
	<main class="profile-container">
		{% if profile.thumbnailName is same as(null) %}
			<div class="profile-banner d-flex" style="background-image: url('/assets/imgs/placeholders/placeholder-picture.png')"></div>
		{% else %}
			<div class="profile-banner d-flex" style="background-image: url({{ asset('uploads/profile/thumbnails/' ~ profile.thumbnailName) }})"></div>
		{% endif %}

		<section class="profile-infos d-flex flex-column align-items-center">
			{% if profile.profilePictureName is same as(null) %}
				<div class="user-pfp-profile rounded-circle mb-2" style="background-image: url('/assets/imgs/placeholders/default-pfp.png')"></div>
			{% else %}
				<div class="user-pfp-profile rounded-circle mb-2" style="background-image: url({{ asset('uploads/profile/profilePictures/' ~ profile.profilePictureName) }})"></div>
			{% endif %}

			<article class="user-profile">
				<div class="username-and-description text-center mb-4">
					<h1>{{ profile.username }}</h1>
					{% if profile.description is not null %}
						<p class="m-auto">{{ profile.description }}</p>
					{% else %}
						<p class="m-auto">Lorem ipsum dolor sit amet consectetur adipisicing elit. A molestias asperiores alias suscipit voluptas nisi quisquam tenetur, eos exercitationem ipsa. Placeat sed cupiditate repudiandae sequi.</p>
					{% endif %}
				</div>

				<div class="hr-profile d-flex m-auto w-75">
					<hr>
				</div>

				<p class="translation-count mb-0 text-center"><i class="fa-solid fa-file-pen"></i>{% trans %}Traductions postées :{% endtrans %} {{ translations|length }}</p>

				<div class="hr-profile d-flex">
					<hr>
				</div>

				<ul class="action-links d-flex justify-content-center">
					<li><a href="{{ path('profile_settings') }}" class="settings"><i class="fa-solid fa-gear me-2"></i>{% trans %}Paramètres{% endtrans %}</a></li>
					<li><a href="{{ logout_path() }}" class="logout"><i class="fa-solid fa-right-from-bracket me-2"></i>{% trans %}Se déconnecter{% endtrans %}</a></li>
				</ul>
			</article>
		</section>

		<section class="d-flex flex-column align-items-center">
			<div class="posts-btn d-flex justify-content-center">
				<a href="{{ path('translation_new_upload') }}" class="create-post">
					<i class="fa-solid fa-plus"></i>{% trans %}Nouvelle publication{% endtrans %}</a>
			</div>

			{% for message in app.flashes('success') %}
				<div class="flash-success">
					{{ message }}
				</div>
			{% endfor %}

			<section class="d-flex flex-row justify-content-center flex-wrap justify-content-around w-75">
				{% for translation in translations %}
					<article class='simple-card-item' id="{{ translation.id }}">
						<div class='simple-card-content'>
							<figure><img src='{{ asset("/assets/imgs/general/slider/#{translation.translationFileExtension}-file-extension.png")}}' alt='File extension' class="rounded-3"/></figure>

							<div class='text-center simple-title'>
								<h3>{{ translation.name }}</h3>
								<h4 class='see-translation-link'>
									<a href='{{ asset("uploads/translations/#{translation.translationFilename}") }}'>{% trans %}Voir la traduction{% endtrans %}</a>
								</h4>
							</div>

							<ul class='simple-text'>
								<li>{% trans %}Type :{% endtrans %}
									<span>{{ translation.translationType.name }}</span>
								</li>
								<li>{% trans %}Style :{% endtrans %}
									<span>{{ translation.translationStyle.name }}</span>
								</li>
								<li>{% trans %}Auteur :{% endtrans %}
									<span>{{ translation.author }}</span>
								</li>
								<li>{% trans %}Langue :{% endtrans %}
									<span>{{ translation.language }}</span>
								</li>
							</ul>

							<ul class='simple-other-infos'>
								<li>{% trans %}Par :{% endtrans %}
									<span>{{ profile.username }}</span>
								</li>
								<li>{% trans %}Postée le :{% endtrans %}
									<span>{{ translation.createdAt | date("d/m/Y") }}</span>
								</li>
							</ul>
							<div class="action-buttons d-flex justify-content-center">
								<a href="{{ path('translation_edit', {id: translation.id}) }}" class="edit d-flex align-items-center">
									<i class="fa-solid fa-pen"></i>{% trans %}Modifier{% endtrans %}
								</a>
								<form action="{{ path('translation_delete', {id: translation.id}) }}" method="post" onsubmit="return confirm('Voulez-vous vraiment supprimer cette traduction ?')" class="d-flex">
									{# Le token sert à sécuriser l'application #}
									{# Le token se nomme "delete-item" #}
									<input type="hidden" name="token" value="{{ csrf_token('delete-item') }}"> <button>
										<i class="fa-solid fa-ban"></i>{% trans %}Supprimer{% endtrans %}</button>
								</form>
							</div>
						</div>
					</article>
				{% endfor %}
			</section>

			<p class="fw-regular message">{{ message }}</p>
		</main>
	{% endblock %}

{% block javascripts %}
	<script src="{{ asset('/js/settings-js/theme.js') }}"></script>
{% endblock %}