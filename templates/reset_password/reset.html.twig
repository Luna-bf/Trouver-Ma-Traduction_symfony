{% extends 'base.html.twig' %}

{% block title %}{% trans %}Réinitialisez votre mot de passe{% endtrans %} - {% trans %}Trouver Ma Traduction{% endtrans %}{% endblock %}

{% block body %}
    <body class="form-body">
		{% block main %}
            <main>
                <section class="form-body__section d-flex flex-column align-items-center justify-content-center text-white">
                    <h1 class="mb-5">{% trans %}Réinitialisez votre mot de passe{% endtrans %}</h1>

                    {{ form_start(resetForm, {'attr': {'class': 'd-flex flex-column mt-2 form-width'}}) }}
                        <div class="d-flex flex-column form-parent-row">
							{{ form_label(resetForm.plainPassword.first, null, {'label_attr': {'class': 'mt-label'}}) }}
							{{ form_widget(resetForm.plainPassword.first, {'attr': {'class': 'd-flex flex-column form-parent-row'}}) }}
						</div>

                        <div class="d-flex flex-column form-parent-row">
							{{ form_label(resetForm.plainPassword.second, null, {'label_attr': {'class': 'mt-label'}}) }}
							{{ form_widget(resetForm.plainPassword.second, {'attr': {'class': 'd-flex flex-column form-parent-row'}}) }}
						</div>
                        
                        <div class="d-flex align-items-center justify-content-center text-danger error-message mt-5" id="password-error">
							{{ form_errors(resetForm.plainPassword.first) }}
						</div>
                        
                        <div>
                            {{ form_widget(resetForm._token) }}
                        </div>
                        
                        <button class="submit-btn text-white w-50 rounded">{% trans %}Enregistrer{% endtrans %}</button>
                    {{ form_end(resetForm) }}
                </section>
            </main>
		{% endblock %}
    </body>
{% endblock %}
