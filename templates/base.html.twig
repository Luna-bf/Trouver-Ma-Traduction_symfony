<!DOCTYPE html>
<html lang="fr">
	{% block head %}
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>
				{% block title %}Base template
				{% endblock %}
			</title>
			<link rel="stylesheet" href="{{ asset('style/main.css') }}">
		</head>
	{% endblock %}

	{% block body %}
		<body>
			<div id="cover-background"></div>

			{% block header %}
				{% include "inc/_header.html.twig" %}
			{% endblock %}

			{% block main %}{% endblock %}

			{% block footer %}
				{% include "inc/_footer.html.twig" %}
			{% endblock %}
		</body>
	{% endblock %}
</html>
