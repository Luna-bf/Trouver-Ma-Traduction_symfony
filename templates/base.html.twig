<!DOCTYPE html>
<html lang="fr">
	{% block head %}
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>
				{% block title %}Base template
				{% endblock %}
			</title>
			<link rel="stylesheet" href="/style/main.css">
			<link rel="icon" href="/assets/imgs/favicon/favicon-48x48.png">
		</head>
	{% endblock %}
	{% block cdn %}{% endblock %}
	{% block script %}{% endblock %}

	{% block body %}
		<body>
			<div id="cover-background"></div>

			{% block header %}
				{% include "inc/_header.html.twig" %}
			{% endblock %}

			{% block main %}{% endblock %}

			{% block footer %}
				{% include "inc/_footer.html.twig" %}
			{% endblock %}
		</body>
	{% endblock %}
</html>
