{% extends "base.html.twig" %}

{% block title %}Modifier une traduction - Trouver Ma Traduction
{% endblock %}

{% block body %}
	<body class="form-body">
		{% block main %}
			<main>
				<section class="form-body__section d-flex flex-column align-items-center justify-content-center text-white">
					<h1 class="mt-1">Modifier la publication</h1>
					{{ form_start(editTranslationForm, {'attr': {'class': 'd-flex flex-column mt-2 form-width'}}) }}
						{{ form_row(editTranslationForm.name) }}
						{{ form_row(editTranslationForm.translationFile) }}
						{{ form_row(editTranslationForm.translationType) }}
						{{ form_row(editTranslationForm.translationStyle) }}
						{{ form_row(editTranslationForm.author) }}
						{{ form_row(editTranslationForm.language) }}
						{{ form_row(editTranslationForm.save, { 'label': 'Enregistrer' }) }}
					{{ form_end(editTranslationForm) }}
				</section>
			</main>
		{% endblock %}
	</body>
{% endblock %}
