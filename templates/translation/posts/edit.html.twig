{% extends "base.html.twig" %}

{% block title %}Modifier une traduction - Trouver Ma Traduction
{% endblock %}

{% block body %}
	<body class="forms-body">
		{% block main %}
			<main class="form-container d-flex">
				<div class="form-parent d-flex">
					{{ form_start(editTranslationForm, {'attr': {'class': 'd-flex'}}) }}
						{{ form_row(editTranslationForm.name) }}
						{{ form_row(editTranslationForm.translationFile) }}
						{{ form_row(editTranslationForm.translationType) }}
						{{ form_row(editTranslationForm.translationStyle) }}
						{{ form_row(editTranslationForm.author) }}
						{{ form_row(editTranslationForm.language) }}
						{{ form_row(editTranslationForm.save) }}
					{{ form_end(editTranslationForm) }}
				</div>
			</main>
		{% endblock %}

		{# <script src="../assets/js/file-visualiser.js"></script> #}
	</body>
{% endblock %}
