{% extends "base.html.twig" %}

{% block title %}Visualisation du document - Trouver Ma Traduction
{% endblock %}

{% block cdn %}
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
{% endblock %}

{% block script %}
	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.6.347/pdf.min.js" integrity="sha512-Z8CqofpIcnJN80feS2uccz+pXWgZzeKxDsDNMD/dJ6997/LSRY+W4NmEt9acwR+Gt9OHN0kkI1CTianCwoqcjQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
{% endblock %}

{% block body %}
	<body class="file-viewer-body">
		<header class="file-viewer-header">
			<ul class="d-flex">
				<li>
					<a href="" download="" class="floppy d-flex">Télécharger</a>
				</li>

				{# <li>
									<a class="print d-flex">Imprimer</a>
								</li> #}
			</ul>
		</header>

		{% block main %}
			<main class="file-viewer-container">
            {# {{ asset("uploads/photos/#{ photo.imageName }") }} #}
                <img src="{{ translation.translationFileName }}" alt="">
                <img src="{{ asset("uploads/translations/#{ translation.translationFileName }") }}" alt="">
				{# <canvas class="pdf-viewer hidden"></canvas> #}
			</main>
		{% endblock %}
	</body>

	{# {% block footer %}
		<footer class="file-viewer-footer d-flex">
			<ul>
				<li class="pdf-pages d-flex">
					<button id="previous">
						<i class="fas fa-arrow-alt-circle-left"></i>
					</button>
					<span id="current_page">0 / 0</span>
					<button id="next">
						<i class="fas fa-arrow-alt-circle-right"></i>
					</button>
				</li>
			</ul>
		</footer>
	{% endblock %} #}
{% endblock %}
