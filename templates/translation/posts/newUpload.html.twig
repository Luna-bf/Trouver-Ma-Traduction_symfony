{% extends "base.html.twig" %}

{% block title %}{% trans %}Publier une traduction{% endtrans %} - {% trans %}Trouver Ma Traduction{% endtrans %}
{% endblock %}

{% block body %}
	<body class="form-body">
		{% block main %}
			<main>
				<section class="form-body__section d-flex flex-column align-items-center justify-content-center text-white">
					<h1 class="mt-1">Nouvelle publication</h1>
					{{ form_start(translationForm, {'attr': {'class': 'd-flex flex-column mt-2 form-width'}}) }}
						{{ form_row(translationForm.name) }}
						{{ form_row(translationForm.translationFile) }}
						{{ form_row(translationForm.translationType) }}
						{{ form_row(translationForm.translationStyle) }}
						{{ form_row(translationForm.author) }}
						{{ form_row(translationForm.language) }}
						{{ form_row(translationForm.save) }}
					{{ form_end(translationForm) }}
				</section>
			</main>
		{% endblock %}
	</body>
{% endblock %}
