{% extends "base.html.twig" %}

{% block title %}{% trans %}Accueil{% endtrans %} - Trouver Ma Traduction
{% endblock %}

{% block extraCSS %}
	<link rel="stylesheet" href="{{ asset('/assets/libs/swiper/swiper-bundle.css') }}"/>
{% endblock %}

{% block main %}
	<main class="accueil-connect-container">
		<a href="{{ path('translation_search_result') }}">Envoyer form</a>
		<h2 class="my-5 ms-3">{% trans %}Nouvelles traductions{% endtrans %}</h2>

		<div class="swiper"> {# Le conteneur principal du slider #}
			<div class="slider-cards-container"> {# Boîte contenant toutes les cartes, leur style ainsi que les fonctionnalités du slider #}
				<div class="swiper-wrapper"> {# Boîte contenant chaque slides (cartes) individuellement. Toutes les cartes seront les enfants de cet élément #}
					{% include "inc/_slider.html.twig" %}
				</div>
			</div>
			
			<div class="swiper-slide-button swiper-button-prev"></div>
			<div class="swiper-slide-button swiper-button-next"></div>
		</div>
	</main>
{% endblock %}

{% block javascripts %}	
	<script src="{{ asset('/assets/libs/swiper/swiper-bundle.js') }}"></script>
	<script type="module" src="{{ asset('/js/slider.js') }}"></script>
	<script src="{{ asset('/js/settings-js/theme.js') }}"></script>
{% endblock %}