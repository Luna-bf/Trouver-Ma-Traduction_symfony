{% extends 'base.html.twig' %}

{% block title %}Inscription - Trouver Ma Traduction
{% endblock %}

{% block body %}
	<body class="forms-body">
		{% block main %}
			<main class="form-container d-flex">
				<div class="form-parent d-flex">
					<h1>Inscription</h1>

					{{ form_errors(registrationForm) }}
					{{ form_start(registrationForm, { 'attr': {'class': 'd-flex'} }) }}
					{{ form_row(registrationForm.username) }}
					{{ form_row(registrationForm.email) }}
					{{ form_row(registrationForm.plainPassword, {
                        label: 'Password'
                    }) }}
					{{ form_row(registrationForm.agreeTerms) }}
					{{ form_row(registrationForm.submit) }}
					{{ form_end(registrationForm) }}

					<div class="account-parent d-flex">
						<div>Vous avez déjà un compte ?
							<a href="{{ path('app_login') }}" class="connect-register-link">Connectez-vous</a>
						</div>
					</div>
				</div>
			</main>
		{% endblock %}
	</body>
{% endblock %}
