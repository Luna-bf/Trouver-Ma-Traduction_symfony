{% extends 'base.html.twig' %}

{% block title %}Inscription - Trouver Ma Traduction
{% endblock %}

{% block body %}
	<body class="form-body">
		{% block main %}
			<main>
				<section class="form-body__section d-flex flex-column align-items-center justify-content-center text-white">
					<h1 class="mb-3 form-section_h1">Inscription</h1>
					{{ form_start(registrationForm, {'attr': {'class': 'd-flex flex-column mt-2 form-width'}}) }}
					{{ form_row(registrationForm.email) }}
					{{ form_row(registrationForm.plainPassword) }}
					
					<div class="mb-3 mt-4" id="remember">
						{{ form_widget(registrationForm.agreeTerms) }}
						{{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions d\'utilisation') }}
					</div>

					{{ form_errors(registrationForm) }}

					{{ form_row(registrationForm.submit) }}
					{{ form_end(registrationForm) }}

					<p class="form-redirection-text">Vous avez déjà un compte ? <a href="{{ path('app_login') }}">Connectez-vous</a></p>
				</section>
			</main>
		{% endblock %}
	</body>
{% endblock %}
