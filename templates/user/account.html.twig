{% extends "base.html.twig" %}

{% block title %}
	{% trans %}Compte{% endtrans %}
	- {% trans %}Trouver Ma Traduction{% endtrans %}
{% endblock %}

{% block main %}
	<main>
		<section class="settings-container d-flex flex-row justify-content-center mx-auto">
			<article
				class="settings-parent">
				{# Settings pages links #}
				<ul class="all-settings d-flex flex-column">
					<li class="mt-0">
						<a href="{{ path('profile_settings') }}" class="d-flex">
							<i class="fa-solid fa-user"></i>
							{% trans %}Profil{% endtrans %}</a>
					</li>
					<li>
						<a href="{{ path('profile_preferences_settings') }}" class="d-flex">
							<i class="fa-solid fa-bookmark"></i>
							{% trans %}Préférence de contenu{% endtrans %}</a>
					</li>
					<li>
						<a href="{{ path('profile_accessibility_settings') }}" class="d-flex">
							<i class="fa-solid fa-universal-access"></i>
							{% trans %}Accessibilité{% endtrans %}</a>
					</li>
					<li class="border-left">
						<a href="{{ path('user_account_settings') }}" class="d-flex">
							<i class="fa-solid fa-gear"></i>
							{% trans %}Votre compte{% endtrans %}</a>
					</li>
				</ul>
			</article>

			<article class="edit-parameters">
				{{ form_start(resetEmailForm, {'attr': {'class': 'd-flex flex-row align-content-center edit-parameters__form'}}) }}
					<div class="d-flex flex-column form-parent-row w-50">
						{{ form_label(resetEmailForm.email, null, {'label_attr':  {'class': 'mt-0 mt-label'}}) }}
						{{ form_widget(resetEmailForm.email, {'attr':  {'class': 'form-input mb-3'}}) }}
					</div>

					<input type="hidden" name="token" value="{{ csrf_token('reset-email') }}">

					{{ form_widget(resetEmailForm.submit, {'attr': {'class': 'reset-btn text-white rounded align-self-center mt-3 ms-3'}}) }}
				{{ form_end(resetEmailForm) }}

				{% for message in app.flashes('success') %}
					<div class="flash-success mb-0 mt-4 d-flex justify-content-start">
						{{ message }}
					</div>
				{% endfor %}

				<hr class="account-hr">

				<div class="d-flex account-params">
					<h3 class="mt-2 fs-3">{% trans %}Autres actions{% endtrans %}</h3>

					<div class="d-flex flex-row justify-content-center">
						<a href="{{ path('user_reset_password') }}" class="rounded password-link me-5">
							<i class="fa-solid fa-key"></i>&ensp;{% trans %}Modifier le mot de passe{% endtrans %}</a>

						{# Ajouter un pop-up de confirmation avertissant que le compte ET le profil seront supprimés #}
						<form action="{{ path('user_account_delete', {id: profile.user.id}) }}" method="post" onsubmit="return confirm('Voulez-vous vraiment supprimer votre compte ? Cette action est irréversible.')">
							<input type="hidden" name="token" value="{{ csrf_token('delete-account') }}">
							<button class="rounded">
								<i class="fa-solid fa-trash-can"></i>&ensp;{% trans %}Supprimer mon compte{% endtrans %}</button>
						</form>
					</div>
				</div>
			</article>
		</section>
	</main>
{% endblock %}

{% block javascripts %}
	<script src="{{ asset('/js/settings-js/theme.js') }}"></script>
{% endblock %}
