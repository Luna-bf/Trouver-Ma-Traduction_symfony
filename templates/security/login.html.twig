{% extends 'base.html.twig' %}

{% block title %}Connexion - Trouver Ma Traduction
{% endblock %}

{% block body %}
	<body class="form-body">
		{% block main %}
			<main>
				<section class="form-body__section d-flex flex-column align-items-center justify-content-center text-white">
					<h1 class="mb-3 form-section_h1">Connexion</h1>

					<form method="post" class="d-flex flex-column mt-2 form-width">

						<div class="d-flex flex-column form-parent-row">
							<label for="email" class="mt-label">Adresse mail</label>
							<input type="email" value="{{ last_username }}" name="email" id="email" class="form-input mb-50" autocomplete="email" required autofocus>
						</div>

						<div class="d-flex flex-column form-parent-row">
							<label for="password" class="mt-label">Mot de passe</label>
							<input type="password" name="password" id="password" class="form-input mb-last-input" autocomplete="current-password" required>

							{# Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
							See https://symfony.com/doc/current/security/remember_me.html #}
							{#
								If you want to control the URL the user
								is redirected to on success (more details below)
								<input type="hidden" name="_target_path" value="/account" />
							#}

							<div class="checkbox mb-3 mt-4" id="remember-me">
								<input type="checkbox" name="_remember_me" id="_remember_me" class="form-checkbox">
								{# <span class="checkmark"></span> #}
								<label for="_remember_me">Se souvenir de moi</label>
							</div>
						</div>

						<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

						{% if error %}
							<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
						{% endif %}

						<div class="d-flex">
							<button type="submit" class="submit-btn text-white w-50 rounded">Se connecter</button>
						</div>

						<div class="d-flex flex-column align-items-center account-parent">
							<a href="#" class="forgotten-password text-white">Mot de passe oublié ?</a>
							<p class="form-redirection-text mt-4" id="no-account">Vous n'avez pas de compte ? <a href="{{ path('app_register') }}">Inscrivez-vous</a></p>
						</div>
					</form>
				</section>
			</main>
		{% endblock %}
	</body>
{% endblock %}
